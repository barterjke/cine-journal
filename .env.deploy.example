# What docker-compose.yml reads on the VM:
#
#     cp .env.deploy.example .env
#
# .env, because that is the filename docker compose picks up without a flag.
#
# The API's own settings — BIND_ADDR, PORT, DATABASE_PATH, REDIS_URL — are not
# here. They belong to the container layout and live in the compose file.
#
# This file should be named .env.deploy.example, and the cp line above assumes it
# is. It is checked in without the leading dot only because the tool that wrote it
# is not allowed to touch .env* paths. Rename it:
#
#     mv env.deploy.example .env.deploy.example
#
# .gitignore already has the !.env.deploy.example negation.

# Hostname whose DNS A record points at this VM. Caddy asks Let's Encrypt for a
# certificate for exactly this name, so it must resolve here before the first
# `docker compose up`. Also the host frontend/vercel.json rewrites to, so changing
# the domain is two edits. Compose refuses to start without it.
API_DOMAIN=api.example.com

# Where Let's Encrypt sends certificate expiry warnings. Required: an empty value
# is a Caddyfile parse error, not an anonymous ACME account.
ACME_EMAIL=you@example.com

# TMDB read access token (the v4 JWT, not the v3 API key), from
# https://www.themoviedb.org/settings/api.
#
# Empty is supported, not a failure: the API serves the demo dataset and every
# screen shows a banner saying the films are invented. Never baked into the image.
TMDB_TOKEN=

# Image tag to run. `latest` follows CI. Put a commit sha here to pin, which makes
# a rollback one edit plus `docker compose up -d`.
API_TAG=latest

# tracing_subscriber EnvFilter syntax. Default logs one line per request.
# cine_journal_api=debug also logs cache hits and misses.
RUST_LOG=cine_journal_api=info,tower_http=info
