# macOS
.DS_Store

# Local Claude Code tool permissions (machine-specific paths)
.claude/

# Secrets — the TMDB read access token lives here
.env
.env.*
# The templates. Each needs its own negation against `.env.*` above.
!.env.example
!.env.deploy.example

# SSH keys. The OCI console downloads the instance key pair as
# `ssh-key-<date>.key` and `.key.pub`. The repo is public, so match by pattern
# rather than by name — the next key you download is covered too.
*.key
*.pem
*.pub
id_rsa*
id_ed25519*

# The visitor's own likes, ratings, watchlist and comments, plus the seeded
# social layer. Local state, not source — recreated on first run.
*.db
*.db-wal
*.db-shm

# Written by `vercel link`. Holds the org and project ids, which are what
# VERCEL_ORG_ID and VERCEL_PROJECT_ID are set from.
.vercel/

# Build
node_modules/
deno.lock
target/
dist/
*.tsbuildinfo

# Vitest coverage reports, written by `npm run test:coverage`
coverage/
