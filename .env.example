# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so keep the
# values here empty.
#
# Without a token the backend still runs: it serves the invented dataset in
# `backend/src/data.rs` and every screen shows a banner saying the films are fake.

# TMDB "API Read Access Token" — the long v4 JWT, not the shorter v3 key. Free,
# from https://www.themoviedb.org/settings/api after signing up.
TMDB_TOKEN=

# The v3 API key from the same page. Not read by the backend: it would have to
# travel as a `?api_key=` query parameter, which the request-tracing layer logs.
# Listed only so a copied `.env` doesn't look like it's missing something.
TMDB_KEY=

# Where the SQLite file goes. Relative paths resolve from wherever `cargo run`
# was invoked, i.e. `backend/`. Defaults to `cine-journal.db`.
# DATABASE_PATH=cine-journal.db

# Port the API binds on 127.0.0.1. The Vite dev server proxies to 3001.
# PORT=3001
